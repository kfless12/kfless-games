# SPEC.md §10.3. Copy to .env for local development.

# Matches the db service in docker-compose.yml. Host port is 5433, not 5432, to
# avoid clashing with a Postgres install already listening on 5432.
DATABASE_URL=postgres://kfless:kfless@localhost:5433/kfless_games

# Phase 1. Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Phase 1. Admin console credential. SPEC.md §3.3 requires 8+ characters.
ADMIN_CREDENTIAL=

# Phase 2. S3-compatible object storage for photos and logos (DO Spaces / R2).
# No local filesystem writes — SPEC.md §9.3.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
