# SPEC.md §10.3. Copy to .env for local development.

# Matches the db service in docker-compose.yml. Host port is 5433, not 5432, to
# avoid clashing with a Postgres install already listening on 5432.
DATABASE_URL=postgres://kfless:kfless@localhost:5433/kfless_games

# REQUIRED. Signs the 90-day session cookie. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# REQUIRED. Break-glass admin elevation at /admin. Only elevates someone who is
# already signed in, so admin actions keep a real actor in audit_log. 8+ chars.
# The normal path to ADMIN is the players.is_admin flag, set in the seed.
ADMIN_CREDENTIAL=

# Phase 2. S3-compatible object storage for photos and logos (DO Spaces / R2).
# No local filesystem writes — SPEC.md §9.3.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
