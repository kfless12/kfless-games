/**
 * The Cloudflare Workers host — SPEC.md §16. Resolves §15.4.
 *
 * The custom domain (kflessgames.kevin-flessa.com) is attached in the
 * Cloudflare dashboard, not here; `wrangler deploy` leaves it alone.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kfless-games",
  "main": ".open-next/worker.js",

  // nodejs_compat is what lets `pg` open a TCP socket to Postgres at all.
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // One hostname only. The session cookie is host-only, so a second hostname
  // is a second place to redeem a magic link and be signed in nowhere useful.
  "workers_dev": false,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kfless-games"
    }
  ],

  // Switches lib/db/index.ts to a per-request pool — SPEC.md §16.3 rule 1.
  "vars": {
    "WORKERS_RUNTIME": "1"
  },

  "observability": {
    "enabled": true
  }
}
